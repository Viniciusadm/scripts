#!/bin/bash

# Pega automaticamente os sinks
notebook_sink="alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__hw_sofhdadsp__sink"
monitor_sink="alsa_output.pci-0000_01_00.1.hdmi-stereo"

# Sink atual
current_sink=$(pactl get-default-sink)

if [ "$current_sink" = "$notebook_sink" ]; then
    new_sink=$monitor_sink
    notify_message="Trocado para o monitor (HDMI)"
else
    new_sink=$notebook_sink
    notify_message="Trocado para o notebook"
fi

pactl set-default-sink "$new_sink"

for stream in $(pactl list short sink-inputs | awk '{print $1}'); do
    pactl move-sink-input "$stream" "$new_sink"
done

notify-send "Saída de Áudio" "$notify_message"

